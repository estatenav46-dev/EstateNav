rules_version = '2';
// DRAFT — not deployed. Staff role comes from Firestore users/{uid}.role.
service firebase.storage {
  match /b/{bucket}/o {
    function isStaff() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'editor'];
    }
    function isImage() { return request.resource.contentType.matches('image/.*') && request.resource.size < 8 * 1024 * 1024; }
    function isPdf() { return request.resource.contentType == 'application/pdf' && request.resource.size < 20 * 1024 * 1024; }

    match /properties/{propertyId}/gallery/{file}    { allow read: if true; allow write: if isStaff() && isImage(); }
    match /properties/{propertyId}/floorplans/{file} { allow read: if true; allow write: if isStaff() && isImage(); }
    match /properties/{propertyId}/brochure/{file}   { allow read: if true; allow write: if isStaff() && isPdf(); }
    match /developers/{developerId}/{file}           { allow read: if true; allow write: if isStaff() && isImage(); }
    match /corridors/{corridorId}/{file}             { allow read: if true; allow write: if isStaff() && isImage(); }
  }
}

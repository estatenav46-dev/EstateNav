# Copy to .env.local for development. On Vercel, add these under
# Project Settings → Environment Variables.

# Data source: 'mock' (in-memory, default) or 'firestore' (after the adapter is connected).
NEXT_PUBLIC_DATA_SOURCE=mock

# Canonical site address for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://estatenav.in

# Advisor contact (fallbacks are built in).
NEXT_PUBLIC_ADVISOR_PHONE=+919740609562
NEXT_PUBLIC_ADVISOR_PHONE_DISPLAY=+91 97406 09562
NEXT_PUBLIC_ADVISOR_WHATSAPP=919740609562
NEXT_PUBLIC_ADVISOR_EMAIL=advisory@estatenav.in

# Admin preview: set to true only in private preview deployments until Firebase Auth exists.
NEXT_PUBLIC_ADMIN_PREVIEW=false

# Firebase web app (browser uploads, and later Google sign-in).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only — enquiries and admin writes). Keep the private key's \n line breaks.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
